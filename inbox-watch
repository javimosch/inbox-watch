#!/usr/bin/env python3
"""inbox-watch — tell me only when a human actually replied.

A non-interactive poller across GitHub, IMAP and Resend inbound. Prints items
NEW since the last run (JSON by default), exit 10 if there were any, else 0 --
so a cron or systemd timer alerts only when something real arrived.

The point is not polling, it is triage. Inbound mail is mostly machine noise:
DMARC aggregate reports, out-of-office autoreplies, CI chatter. A notifier that
pings for all of it gets muted, and then the reply that mattered is muted with
it. So every item is classified dmarc / autoreply / reply, and only `reply` is
a human typing something.

Config: ~/.inbox-watch/config.json (see config.example.json). Env vars carry
secrets and override the file.
State:  ~/.inbox-watch/state.json, or per-consumer via --consumer NAME."""
import os, sys, json, subprocess, datetime, imaplib, email, ssl
from email.header import decode_header

# Cursor state. ONE file per consumer, because the cursor is per-consumer by
# nature: reading an item marks it seen, so two watchers sharing a file steal
# each other's items -- the second to poll sees nothing and its alert never
# fires. Default path is unchanged, so an existing deployment keeps its cursor.
#   --consumer NAME  -> ~/.inbox-watch/state-NAME.json
#   --state PATH     -> exactly PATH   (env: INBOX_WATCH_STATE)
def _state_path(argv):
    for i, a in enumerate(argv):
        if a == "--state" and i + 1 < len(argv):
            return os.path.expanduser(argv[i + 1])
        if a.startswith("--state="):
            return os.path.expanduser(a.split("=", 1)[1])
        if a == "--consumer" and i + 1 < len(argv):
            return os.path.expanduser("~/.inbox-watch/state-%s.json" % argv[i + 1])
        if a.startswith("--consumer="):
            return os.path.expanduser("~/.inbox-watch/state-%s.json" % a.split("=", 1)[1])
    if os.environ.get("INBOX_WATCH_STATE"):
        return os.path.expanduser(os.environ["INBOX_WATCH_STATE"])
    return os.path.expanduser("~/.inbox-watch/state.json")

STATE = _state_path(sys.argv)

# ---- configuration -------------------------------------------------------
# Everything site-specific lives in a config file, never in the source. Absent
# config is not an error: each channel reports itself disabled with the reason,
# so a fresh clone runs and tells you what it needs.
CONFIG_PATH = os.path.expanduser(
    os.environ.get("INBOX_WATCH_CONFIG", "~/.inbox-watch/config.json"))

def load_config():
    try:
        return json.load(open(CONFIG_PATH))
    except Exception:
        return {}

CFG = load_config()

def cfg(path, default=None):
    """cfg("github.repos", []) -> nested lookup with a default."""
    cur = CFG
    for part in path.split("."):
        if not isinstance(cur, dict) or part not in cur:
            return default
        cur = cur[part]
    return cur

def load_state():
    try: return json.load(open(STATE))
    except Exception: return {}
def save_state(s):
    os.makedirs(os.path.dirname(STATE), exist_ok=True); json.dump(s, open(STATE,"w"))

def sh(args):
    return subprocess.run(args, capture_output=True, text=True, timeout=60)

def gh_check(state):
    items, err = [], None
    try:
        # 1. unread GitHub notifications (mentions, comments, review requests)
        r = sh(["gh","api","/notifications","--jq",
                '.[] | {reason, title: .subject.title, type: .subject.type, url: .subject.url, updated: .updated_at, repo: .repository.full_name}'])
        seen = set(state.get("github_notif_seen", []))
        newseen = list(seen)
        # signal only: our product repos, OR notifications that directly involve you
        SIGNAL_REASONS = {"mention","comment","review_requested","team_mention"}
        for line in r.stdout.splitlines():
            if not line.strip(): continue
            n = json.loads(line)
            repo = n.get("repo") or ""
            reason = n.get("reason") or ""
            if reason not in SIGNAL_REASONS:
                continue  # inbound only: drop ci_activity, author, subscribed, state_change
            key = (n.get("url") or n.get("title","")) + (n.get("updated") or "")
            if key in seen: continue
            newseen.append(key)
            items.append({"channel":"github","kind":reason,"from":repo,
                          "title":n.get("title",""),"url":api_to_html(n.get("url") or ""),"ts":n.get("updated","")})
        state["github_notif_seen"] = newseen[-500:]
        # 2. new comments on specific issue/PR threads you care about. A watched
        #    thread is usually one where you left something and want the answer,
        #    which GitHub's own notifications bury under subscribed-repo noise.
        me = cfg("github.self", "")
        for th in cfg("github.threads", []):
            repo, num = th.get("repo"), th.get("number")
            if not repo or not num:
                continue
            label = th.get("label") or f"{repo}#{num}"
            r2 = sh(["gh","api",f"/repos/{repo}/issues/{num}/comments","--jq",
                     '.[] | {id, user: .user.login, ts: .created_at, url: .html_url}'])
            key = "thread_comment_ids"
            xseen = set(state.get(key, state.get("x402_comment_ids", [])))
            for line in r2.stdout.splitlines():
                if not line.strip(): continue
                c = json.loads(line)
                if str(c["id"]) in xseen: continue
                xseen.add(str(c["id"]))
                if c["user"] != me and not c["user"].endswith("[bot]"):
                    items.append({"channel":"github","kind":"thread-reply","from":c["user"],
                                  "title":f"comment on {label}","url":c["url"],"ts":c["ts"]})
            state[key] = sorted(xseen)[-300:]
    except Exception as e:
        err = f"github: {e}"
    return items, err

def api_to_html(u):
    if not u: return ""
    return u.replace("https://api.github.com/repos/","https://github.com/").replace("/pulls/","/pull/")

def zoho_check(state):
    pw = os.environ.get("ZOHO_IMAP_PASS")
    if not pw:
        return [], "zoho: set ZOHO_IMAP_PASS (Zoho app-specific password) to enable — see 'inbox-watch setup'"
    user = os.environ.get("ZOHO_IMAP_USER") or cfg("imap.user", "")
    host = os.environ.get("ZOHO_IMAP_HOST") or cfg("imap.host", "imap.zoho.eu")
    if not user:
        return [], "imap: set ZOHO_IMAP_USER or imap.user in config.json"
    items = []
    try:
        M = imaplib.IMAP4_SSL(host, 993, ssl_context=ssl.create_default_context())
        M.login(user, pw); M.select("INBOX")
        typ, data = M.search(None, "UNSEEN")
        last = set(state.get("zoho_seen_uids", []))
        newlast = list(last)
        for numid in data[0].split():
            typ, msg_data = M.fetch(numid, "(BODY.PEEK[HEADER.FIELDS (FROM SUBJECT DATE MESSAGE-ID)])")
            raw = msg_data[0][1].decode(errors="replace")
            m = email.message_from_string(raw)
            mid = m.get("Message-ID","") or numid.decode()
            if mid in last: continue
            newlast.append(mid)
            frm = str(m.get("From","")); subj = dh(m.get("Subject",""))
            # skip our own automated mail (digests, no-reply)
            if any(x in frm.lower() for x in ("no-reply","noreply","digest","postmaster")): continue
            items.append({"channel":"zoho","kind":"email","from":frm,"title":subj,
                          "url":"","ts":str(m.get("Date",""))})
        state["zoho_seen_uids"] = newlast[-1000:]
        M.logout()
    except Exception as e:
        return [], f"zoho: {e}"
    return items, None

def dh(s):
    try:
        parts = decode_header(s); out=""
        for t,enc in parts: out += t.decode(enc or "utf-8",errors="replace") if isinstance(t,bytes) else t
        return out
    except Exception: return s

# Inbound mail is not all the same thing, and treating it as one stream is why a notification
# saying "1 new" was usually a DMARC aggregate report. Three kinds:
#
#   dmarc     — machine-generated deliverability reports. Real value in AGGREGATE (a spike means
#               something is wrong with sending), zero value one at a time. Counted, never pinged.
#   autoreply — out-of-office. Not a reply, but not noise either: it proves the address is live
#               and a human exists behind it. Pinged, but LABELLED so it reads correctly.
#   reply     — an actual person typed something. This is what the notification exists for.
DMARC_FROM = ("dmarc", "dmarcreport", "noreply-dmarc", "mimecastreport", "report@", "postmaster@")
DMARC_SUBJ = ("report domain:", "report_domain:", "aggregate report", "dmarc aggregate")
AUTO_SUBJ  = ("automatic reply", "auto-reply", "autoreply", "out of office", "out-of-office",
              "away from the office", "annual leave", "réponse automatique", "abwesenheit")

def classify_inbound(frm, subject):
    f = (frm or "").lower()
    s = (subject or "").lower()
    if any(k in f for k in DMARC_FROM) or any(s.startswith(k) or k in s for k in DMARC_SUBJ):
        return "dmarc"
    if any(s.startswith(k) or k in s for k in AUTO_SUBJ):
        return "autoreply"
    return "reply"

def resend_check(state):
    # Mail delivered to a receiving-enabled Resend domain is pollable via
    # GET /emails/inbound. NOTE: RESEND_API_KEY can also SEND -- prefer the
    # `mailbox` channel with a read-only token where one is available.
    import urllib.request
    key = os.environ.get("RESEND_API_KEY","")
    if not key:
        return [], "resend: set RESEND_API_KEY to enable inbound polling"
    items = []
    try:
        # Resend 403s the default Python-urllib User-Agent — set a real one.
        req = urllib.request.Request("https://api.resend.com/emails/inbound",
                                     headers={"Authorization": f"Bearer {key}",
                                              "User-Agent": "inbox-watch/1.0"})
        data = json.load(urllib.request.urlopen(req, timeout=30)).get("data", [])
        seen = set(state.get("resend_inbound_ids", []))
        newseen = list(seen)
        for e in data:
            eid = str(e.get("id") or (str(e.get("from","")) + str(e.get("created_at",""))))
            if eid in seen: continue
            newseen.append(eid)
            frm = e.get("from","")
            if isinstance(frm, dict): frm = frm.get("email") or frm.get("address") or str(frm)
            subject = e.get("subject","")
            kind = classify_inbound(frm, subject)
            items.append({"channel":"resend","kind":kind,"from":frm,
                          "title":subject,"url":"https://resend.com/emails",
                          "ts":e.get("created_at", e.get("created",""))})
        state["resend_inbound_ids"] = newseen[-1000:]
    except Exception as ex:
        return [], f"resend: {ex}"
    return items, None


def mailbox_check(state):
    # A token-gated inbound-mail service exposing GET /api/inbound
    # (e.g. machin-resend-inbox). Preferred over the raw `resend` channel when
    # available: it needs only a read-scoped token, whereas RESEND_API_KEY can
    # also SEND -- so the notifier holds no authority to send mail as you.
    import urllib.request
    tok = os.environ.get("INBOX_TOKEN", "")
    if not tok:
        return [], "mailbox: set INBOX_TOKEN (read-only inbound token) to enable"
    base = os.environ.get("INBOX_URL") or cfg("mailbox.url", "")
    if not base:
        return [], "mailbox: set INBOX_URL or mailbox.url in config.json"
    items = []
    try:
        req = urllib.request.Request(base + "/api/inbound",
                                     headers={"Authorization": "Bearer " + tok,
                                              "User-Agent": "inbox-watch/1.0"})
        data = json.load(urllib.request.urlopen(req, timeout=30))
        if isinstance(data, dict):
            data = data.get("data") or data.get("inbound") or []
        # migrate the pre-rename cursor: losing it would re-alert the backlog
        seen = set(state.get("mailbox_ids", state.get("intrane_inbox_ids", [])))
        newseen = list(seen)
        for e in data:
            eid = str(e.get("id") or (str(e.get("from", "")) + str(e.get("created_at", ""))))
            if eid in seen:
                continue
            newseen.append(eid)
            frm = e.get("from", "")
            if isinstance(frm, dict):
                frm = frm.get("email") or frm.get("address") or str(frm)
            subject = e.get("subject", "")
            items.append({"channel": "mailbox",
                          "kind": classify_inbound(frm, subject),
                          "from": frm, "title": subject,
                          "url": base + "/?token=<token>",
                          "ts": e.get("created_at", "")})
        state["mailbox_ids"] = newseen[-1000:]
    except Exception as ex:
        return [], f"mailbox: {ex}"
    return items, None


def linkedin_check(state):
    # No LinkedIn notifications API. The authed hidden-Edge/CDP session
    # (linkedin.session_file) may exist, but a notifications-page fetcher is not
    # built. Enable by adding one (scrape /notifications via CDP) and wiring it here.
    li = os.path.expanduser(cfg("linkedin.session_file", "~/.config/linkedin/li_at"))
    if os.path.exists(li):
        return [], "linkedin: authed session present but no notifications fetcher yet — needs a CDP scraper of linkedin.com/notifications"
    return [], f"linkedin: no authed session ({li})"

def main():
    peek = "--peek" in sys.argv
    seed = "--seed" in sys.argv

    args = sys.argv[1:]
    if args and args[0] == "setup":
        print(SETUP); return
    human = "--human" in args
    state = load_state()
    all_items, errs = [], []
    for fn in (gh_check, mailbox_check, resend_check, zoho_check, linkedin_check):
        items, err = fn(state)
        all_items += items
        if err: errs.append(err)
    # --peek reports WITHOUT committing state. Running the poller is otherwise
    # destructive to the alert path: it marks items seen, so a manual debug run
    # silently eats the notification the cron would have sent. Found the hard
    # way -- a verification loop that polled twice per iteration swallowed its
    # own test alert.
    if not peek:
        save_state(state)
    if seed:
        # Mark everything seen without reporting it. A fresh consumer would
        # otherwise alert on the entire backlog on its first run.
        print(f"seeded {len(all_items)} item(s) as seen -> {STATE}")
        sys.exit(0)
    if human:
        if all_items:
            for it in all_items:
                print(f"[{it['channel']}/{it['kind']}] {it['from']}: {it['title']}  {it['url']}")
        else:
            print("no new items")
        for e in errs: print(f"  (disabled) {e}", file=sys.stderr)
    else:
        json.dump({"new": all_items, "count": len(all_items), "disabled": errs}, sys.stdout, indent=2)
        print()
    sys.exit(10 if all_items else 0)

SETUP = """inbox-watch — configure ~/.inbox-watch/config.json (see config.example.json),
then enable each channel with its secret:

  mailbox   export INBOX_TOKEN=<tok>       — a token-gated inbound service exposing
            GET /api/inbound (e.g. machin-resend-inbox). Set mailbox.url in config
            or INBOX_URL. PREFER THIS over `resend`: the token cannot send mail.
  resend    export RESEND_API_KEY=<re_...> — Resend inbound. This key can also SEND.
  imap      export ZOHO_IMAP_PASS=<app pw> — plus imap.user / imap.host in config.
            Needs an app-specific password and IMAP enabled for that mailbox.
  github    needs the authenticated `gh` CLI. Configure github.repos,
            github.threads and github.self in config.json.
  linkedin  not built (no notifications API); needs a session scraper.

Flags:
  --consumer NAME   separate cursor (~/.inbox-watch/state-NAME.json). REQUIRED if
            more than one watcher polls the same source on one host: the cursor is
            consumed on read, so watchers sharing a state file steal each other's items.
  --state PATH      explicit cursor file (env: INBOX_WATCH_STATE)
  --seed    mark everything currently pending as seen, reporting nothing. Run once
            when adding a consumer, or it alerts on the whole backlog.
  --peek    report without marking seen — use for ANY diagnostic run, otherwise you
            consume the alert your cron would have sent.
  --human   readable lines instead of JSON.

Exit code: 10 if new items, 0 otherwise — so cron alerts only when something arrived.
"""

if __name__ == "__main__": main()
