#!/usr/bin/env bash
# inbox-watch → Telegram. Deployed at /opt/inbox-watch/run.sh (secrets filled in there).
#
# The poller reports EVERY new inbound item; this decides what is worth interrupting a human
# for. That separation matters: a DMARC aggregate report is real data (a spike in them means
# something is wrong with sending) but is worthless one at a time, and three of the last four
# pings were exactly that. A notifier that mostly cries wolf gets muted, and then the reply that
# mattered is muted with it.
#
#   dmarc     counted, never pinged on its own
#   autoreply pinged but LABELLED, so an out-of-office does not read as a reply
#   reply     the thing this exists for
export HOME=/home/dk1
export RESEND_API_KEY="__RESEND_API_KEY__"
TG_TOKEN="__TG_TOKEN__"
TG_CHAT="__TG_CHAT__"

OUT=$(/opt/inbox-watch/inbox-watch 2>/dev/null); RC=$?
[ "$RC" = "10" ] || exit 0

MSG=$(echo "$OUT" | python3 -c "
import json,sys
d=json.load(sys.stdin)
items=d.get('new',[])
# split by kind; anything without a kind is treated as a real reply (fail loud, not silent)
noisy   = [i for i in items if i.get('kind')=='dmarc']
signal  = [i for i in items if i.get('kind')!='dmarc']
if not signal:
    # nothing a human needs to see. Say nothing at all — an alert channel earns its
    # attention by being quiet when there is nothing to say.
    sys.exit(1)
L=['📥 inbox-watch: %d new'%len(signal)]
for it in signal:
    tag = '[auto-reply] ' if it.get('kind')=='autoreply' else ''
    L.append('• %s[%s] %s: %s'%(tag,it.get('channel',''),it.get('from',''),(it.get('title','') or '')[:120]))
    if it.get('url'): L.append('  '+it['url'])
if noisy:
    # carried along only because a human is already being interrupted; never a reason to
    # interrupt on its own. A jump here is the deliverability signal worth noticing.
    L.append('')
    L.append('(+%d DMARC report%s, suppressed)'%(len(noisy),'' if len(noisy)==1 else 's'))
print('\n'.join(L)[:3800])
") || exit 0

curl -s "https://api.telegram.org/bot${TG_TOKEN}/sendMessage" \
  --data-urlencode "chat_id=${TG_CHAT}" --data-urlencode "text=${MSG}" >/dev/null
